<!doctype html>
<html lang="{{ $contentLocale }}" data-workspace-prefix="{{ $workspacePrefix }}"><head>{!! $documentHead !!}<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="{{ $description }}"><title>{{ $title }} · CajeerEngine Book</title><link rel="stylesheet" href="/assets/book.css"><script src="/assets/book.js" defer></script><script src="/assets/analytics.js" defer></script><script src="/assets/studio-media.js" defer></script><script src="/assets/diagrams.js" defer></script><script src="/assets/studio-editor.js" defer></script><script src="/assets/media.js" defer></script><script src="/assets/page-tree.js" defer></script><script src="/assets/organizations.js" defer></script><script src="/assets/markdown-import.js" defer></script></head><body><div id="book-analytics-config" data-config="{{ $analyticsSettings }}" hidden></div>
<header class="top" lang="{{ $uiLocale }}"><a class="brand" href="{{ $homeUrl }}"><span class="logo">C</span> Cajeer<span>Book</span></a><form class="search" action="{{ $searchUrl }}"><input name="q" aria-label="{{ $searchPlaceholder }}" placeholder="{{ $searchPlaceholder }}…" value="{{ $query }}"><input type="hidden" name="locale" value="{{ $searchLocale }}"><button>{{ $searchLabel }}</button></form>{!! $studioLink !!}{!! $controlLinks !!}{!! $uiLinks !!}<button id="theme" type="button" aria-label="{{ $themeLabel }}">◐</button></header>
<div class="shell"><aside class="sidebar"><div class="side-label" lang="{{ $uiLocale }}">{{ $documentationLabel }}</div>{!! $nav !!}</aside><main id="main" lang="{{ $contentLocale }}">{!! $body !!}</main><aside class="toc">{!! $toc !!}</aside></div><footer class="foot" lang="{{ $uiLocale }}">CajeerEngine Book · {{ $footerLabel }}</footer></body></html>
