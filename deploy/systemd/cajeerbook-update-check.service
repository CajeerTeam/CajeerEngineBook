[Unit]
Description=CajeerEngine Book unprivileged scheduled GitHub update check
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=BOOK_COMPOSE_PROJECT=book
ExecStart=/opt/trusted-book-tools/update-scheduler-host.sh
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
