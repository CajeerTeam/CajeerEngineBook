[Unit]
Description=CajeerEngine Book trusted local update broker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=cajeerbook
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /opt/trusted-book-tools/update-agent.py serve --state-dir /var/lib/book-update-agent --updater /opt/trusted-book-tools/update.py --socket /run/cajeerbook/agent.sock --allowed-uid 33 --allowed-gid 33 --permit-file /etc/cajeerbook/update-permit.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/etc/cajeerbook
ProtectHome=read-only
PrivateDevices=true
PrivateTmp=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
