          "refId": "A",
          "expr": "sum(rate(book_redis_cache_hits_total[5m])) / clamp_min(sum(rate(book_redis_cache_hits_total[5m]))+sum(rate(book_redis_cache_misses_total[5m])),0.001)",
          "legendFormat": "{{route}}{{operation}}{{component}}{{state}}"
