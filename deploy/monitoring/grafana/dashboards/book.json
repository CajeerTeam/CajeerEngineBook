      "datasource": {
        "type": "prometheus",
        "uid": "book-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(book_http_requests_total{status=\"5xx\"}[5m]))",
          "legendFormat": "{{route}}{{operation}}{{component}}{{state}}"
        }
