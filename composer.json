{
    "name": "cajeerteam/cajeer-engine-book",
    "description": "Self-hosted documentation and knowledge-base platform",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.4.1 <9.0",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-phar": "*",
        "league/commonmark": "^2.10.7"
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@php tests/smoke.php",
            "@php tests/markdown-policy.php",
            "@php tests/markdown.php",
            "@php tests/editor.php",
            "@php tests/media.php",
            "@php tests/images.php",
            "bash tests/http.sh",
            "@php tests/page-tree.php",
            "@php tests/page-tree-integration.php",
            "bash tests/page-tree-http.sh",
            "@php tests/rich-blocks.php"
        ]
    }
}
