{
    "name": "cajeerteam/cajeer-engine-book",
    "description": "Self-hosted documentation and knowledge-base platform",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-phar": "*",
        "ext-zip": "*",
        "league/commonmark": "^2.10.7",
        "php": ">=8.4.1 <9.0",
        "symfony/yaml": "^7.4.23"
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@php tests/sdk.php",
            "python3 tests/sdk-clients.py",
            "@php tests/playground.php",
            "python3 tests/playground-https.py",
            "python3 tests/playground-http.py",
            "@php tests/openapi.php",
            "python3 tests/openapi-http.py",
            "@php tests/gitlab.php",
            "python3 tests/gitlab-https.py",
            "python3 tests/github-http.py --gitlab",
            "@php tests/github.php",
            "python3 tests/github-http.py",
            "@php tests/import.php",
            "python3 tests/import-http.py",
            "@php tests/stable.php",
            "@php tests/installation.php",
            "python3 tests/installation-http.py",
            "@php tests/activity.php",
            "python3 tests/team-http.py",
            "@php tests/identity.php",
            "python3 tests/identity-http.py",
            "@php tests/organizations.php",
            "python3 tests/organizations-http.py",
            "@php tests/workspaces.php",
            "python3 tests/workspaces-http.py",
            "@php tests/permissions.php",
            "python3 tests/permissions-http.py",
            "@php tests/reviews.php",
            "python3 tests/reviews-http.py",
            "@php tests/history.php",
            "python3 tests/history-http.py",
            "@php tests/privacy.php",
            "python3 tests/privacy-http.py",
            "@php tests/smoke.php",
            "@php tests/markdown-policy.php",
            "@php tests/markdown.php",
            "@php tests/editor.php",
            "@php tests/media.php",
            "@php tests/images.php",
            "bash tests/http.sh",
            "@php tests/page-tree.php",
            "@php tests/page-tree-integration.php",
            "bash tests/page-tree-http.sh",
            "@php tests/rich-blocks.php",
            "@php tests/interactive-blocks.php",
            "@php tests/mermaid.php",
            "@php tests/release.php",
            "python3 tests/release-http.py"
        ]
    }
